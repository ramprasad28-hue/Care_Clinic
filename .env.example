# ============================================================
# Anmaya Health Clinic — Environment Variables (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to ".env" and replace every placeholder with a
# real value. NEVER commit ".env" or real credentials.
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (MySQL / MariaDB) ---
# Provisional: confirm with employer whether MySQL is mandatory.
DB_ENGINE=django.db.backends.mysql
DB_NAME=anmaya_clinic
DB_USER=anmaya_clinic_user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Timezone / locale ---
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LANGUAGE_CODE=en-us

# --- Email (optional: reminders / notifications) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Booking rules (provisional defaults; confirm in Phase 1) ---
BOOKING_CANCELLATION_WINDOW_HOURS=24
BOOKING_REQUIRE_RECEPTIONIST_APPROVAL=True
