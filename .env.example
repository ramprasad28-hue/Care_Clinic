# ============================================================
# Care_Clinic — Environment Variables (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to ".env" and replace every placeholder with a
# real value. NEVER commit ".env" or real credentials.
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database backend selector ---
# mysql  -> MySQL/InnoDB via mysqlclient (intended primary DB, ADR-003)
# sqlite -> documented local fallback ONLY while MySQL is unavailable
DB_ENGINE=mysql

# --- Database connection (used when DB_ENGINE=mysql) ---
DATABASE_NAME=care_clinic
DATABASE_USER=care_clinic_user
DATABASE_PASSWORD=replace-with-db-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# --- Optional MySQL TLS ---
# Leave empty for the default local connection (unchanged behavior).
# For a remote MySQL server, set this to a CA certificate bundle path that
# verifies the server identity; the client is then configured with
# ssl_mode=VERIFY_IDENTITY — the connection must be encrypted, the server
# certificate chain is checked against the CA, and the certificate's
# hostname is verified (a CA bundle alone verifies only the chain).
# Certificate files are environment/server assets — never commit them to
# the repository. Remote users, host grants, certificates and network
# access are separate deployment tasks (see docs/mysql-validation.md §6).
DATABASE_SSL_CA=

# --- Email (SMTP) ---
# Local development always uses the console backend (emails are printed,
# nothing is sent). Production reads the real SMTP configuration from
# these variables — the provider (hostname, credentials, sender address)
# must be supplied by whoever deploys; no provider is preselected.
# EMAIL_USE_TLS and EMAIL_USE_SSL are mutually exclusive: set only one.
# Never commit real credentials (and never push them into this file).
# EMAIL_BACKEND defaults to the Django SMTP backend; EMAIL_TIMEOUT is
# optional (seconds; unset blocks until the server answers).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-at-deployment
EMAIL_PORT=587
EMAIL_HOST_USER=replace-at-deployment
EMAIL_HOST_PASSWORD=replace-at-deployment
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=replace-at-deployment
